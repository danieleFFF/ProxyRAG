# ChromaDB is distributed with the repo at ./embeddings/db_gemma — no path needed.

# Ollama — base URL reachable from inside Docker containers.
# Windows/Mac: http://host.docker.internal:11434
# Linux: replace with the host IP (e.g. http://172.17.0.1:11434)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Django secret key — generate one at: https://djecrety.ir
DJANGO_SECRET_KEY=

# Comma-separated list of allowed hosts.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,proxy

# Keycloak admin credentials.
KEYCLOAK_ADMIN_PASSWORD=
